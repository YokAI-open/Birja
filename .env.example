# Copy to .env (git-ignored): cp .env.example .env
# Use letters/digits only in passwords: they are embedded in connection URLs.
# Production values must be different and strong. These are dev-only placeholders.

# Runtime environment: dev | test | prod
ENV=dev

# Postgres superuser/database created on first start of the dev stack
POSTGRES_USER=yokai
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=yokai

# Redis password (requirepass)
REDIS_PASSWORD=change-me-dev-only
