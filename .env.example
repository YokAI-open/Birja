# Copy to .env (git-ignored): cp .env.example .env
# Use letters/digits only in passwords: they are embedded in connection URLs.
# Production values must be different and strong. These are dev-only placeholders.

# Runtime environment: dev | test | prod
ENV=dev

# Postgres superuser/database created on first start of the dev stack
POSTGRES_USER=birja
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=birja

# Redis password (requirepass)
REDIS_PASSWORD=change-me-dev-only

# HMAC key for one-time sign-in codes (min 32 chars). Dev placeholder; production
# needs its own: python -c "import secrets; print(secrets.token_urlsafe(48))"
OTP_HMAC_SECRET=change-me-dev-only-otp-hmac-secret-0123456789

# HMAC key for signing access-token JWTs (min 32 chars, must differ from the OTP key).
JWT_SECRET=change-me-dev-only-jwt-secret-abcdefghijklmnop

# Email backend: console (codes appear in the backend log) or resend.
# ENV=prod requires EMAIL_BACKEND=resend.
# Set RESEND_API_KEY only in your local, git-ignored .env. Never commit it, paste it
# into chat, or put it in CI.
# EMAIL_FROM must use your Resend-verified domain, e.g. "Birja <login@your-domain>" (quote it).
EMAIL_BACKEND=console
RESEND_API_KEY=
EMAIL_FROM=

# Rate limits (fixed windows; limits are counts, windows are seconds). All optional;
# the values below are the defaults. In dev, all browser traffic shares the Vite
# proxy's single IP bucket, so the per-IP limits default to 200 request / 300 verify
# there (strict 20 / 30 in test and prod). Uncomment to override.
# RL_REQUEST_EMAIL_LIMIT=5
# RL_REQUEST_EMAIL_WINDOW=600
# RL_REQUEST_IP_LIMIT=20
# RL_REQUEST_IP_WINDOW=3600
# RL_VERIFY_EMAIL_LIMIT=10
# RL_VERIFY_EMAIL_WINDOW=600
# RL_VERIFY_EMAIL_DAILY_LIMIT=30
# RL_VERIFY_EMAIL_DAILY_WINDOW=86400
# RL_VERIFY_IP_LIMIT=30
# RL_VERIFY_IP_WINDOW=600
# RL_SEND_GLOBAL_LIMIT=100
# RL_SEND_GLOBAL_WINDOW=3600

# Price source for the scheduler: kraken (real public Ticker, default) or fake (offline, deterministic; refused when ENV=prod).
PRICE_SOURCE=kraken

# Stock discovery remains disabled until separately reviewed product rights and
# bounded private verification are approved; a key/flag grants no permission.
# Both loops run concurrently in ONE scheduler process. Stock failures never
# delay crypto; stock quotes are collected only during verified regular sessions.
STOCK_DATA_ENABLED=false
STOCK_FEED=iex
STOCK_POLL_INTERVAL_SECONDS=60
STOCK_REQUEST_TIMEOUT_SECONDS=5
STOCK_MAX_RETRIES=1
STOCK_CYCLE_BUDGET_SECONDS=15
STOCK_MAX_RESPONSE_BYTES=262144
# Local scope identifiers must match reviewed admission evidence.
STOCK_DATA_ACCOUNT=birja
STOCK_DATA_SERVER=birja
# Corporate-action collection is independent and OFF until its separate rights,
# actual quotas/replay history and coverage baseline are verified. These are
# internal safety caps, not a provider SLA. Never enable stock execution here.
STOCK_ACTIONS_ENABLED=false
STOCK_ACTIONS_POLL_INTERVAL_SECONDS=60
STOCK_ACTIONS_HEALTH_MAX_AGE_SECONDS=120
STOCK_ACTIONS_MAX_ATTEMPTS=8
STOCK_ACTIONS_CYCLE_BUDGET_SECONDS=30
STOCK_ACTIONS_MAX_RESPONSE_BYTES=262144
STOCK_ACTIONS_SEGMENT_DAYS=31
STOCK_ACTIONS_FUTURE_DAYS=90
# First possible ownership instant, explicitly reviewed UTC; required to enable.
STOCK_ACTIONS_COVERAGE_START=
STOCK_ACCOUNT_REQUESTS_PER_MINUTE=20
# Place real keys ONLY in the private scheduler env, never the API/frontend env.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# Compose forwards these two keys ONLY to scheduler. Backend receives only the
# nonsecret enable/feed/account/server scope. Do not put provider keys in VITE_*.
# Administrative evidence import uses separate private shell variables, not
# runtime settings: MIGRATOR_DATABASE_URL and STOCK_EVIDENCE_FILE. See
# deploy/STOCK-DATA-ADMISSION.md. Do not add a migrator DSN to either runtime.
