# Copy to .env (git-ignored): cp .env.example .env
# Use letters/digits only in passwords: they are embedded in connection URLs.
# Production values must be different and strong. These are dev-only placeholders.

# Runtime environment: dev | test | prod
ENV=dev

# Postgres superuser/database created on first start of the dev stack
POSTGRES_USER=birja
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=birja

# Redis password (requirepass)
REDIS_PASSWORD=change-me-dev-only

# HMAC key for one-time sign-in codes (min 32 chars). Dev placeholder; production
# needs its own: python -c "import secrets; print(secrets.token_urlsafe(48))"
OTP_HMAC_SECRET=change-me-dev-only-otp-hmac-secret-0123456789

# HMAC key for signing access-token JWTs (min 32 chars, must differ from the OTP key).
JWT_SECRET=change-me-dev-only-jwt-secret-abcdefghijklmnop

# Email backend: console (codes appear in the backend log) or resend.
# ENV=prod requires EMAIL_BACKEND=resend.
# Set RESEND_API_KEY only in your local, git-ignored .env. Never commit it, paste it
# into chat, or put it in CI.
# EMAIL_FROM must use your Resend-verified domain, e.g. "Birja <login@your-domain>" (quote it).
EMAIL_BACKEND=console
RESEND_API_KEY=
EMAIL_FROM=

# Rate limits (fixed windows; limits are counts, windows are seconds). All optional;
# the values below are the defaults. In dev, all browser traffic shares the Vite
# proxy's single IP bucket, so the per-IP limits default to 200 request / 300 verify
# there (strict 20 / 30 in test and prod). Uncomment to override.
# RL_REQUEST_EMAIL_LIMIT=5
# RL_REQUEST_EMAIL_WINDOW=600
# RL_REQUEST_IP_LIMIT=20
# RL_REQUEST_IP_WINDOW=3600
# RL_VERIFY_EMAIL_LIMIT=10
# RL_VERIFY_EMAIL_WINDOW=600
# RL_VERIFY_EMAIL_DAILY_LIMIT=30
# RL_VERIFY_EMAIL_DAILY_WINDOW=86400
# RL_VERIFY_IP_LIMIT=30
# RL_VERIFY_IP_WINDOW=600
# RL_SEND_GLOBAL_LIMIT=100
# RL_SEND_GLOBAL_WINDOW=3600

# Price source for the scheduler: kraken (real public Ticker, default) or fake (offline, deterministic; refused when ENV=prod).
PRICE_SOURCE=kraken
